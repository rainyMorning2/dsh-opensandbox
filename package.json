{
  "name": "@codebam/dsh-opensandbox",
  "version": "0.2.2",
  "description": "Run DeepSeek Harness command execution in OpenSandbox containers: an OpenSandbox-backed ctx.subprocess and container-world ctx.sandbox for dsh.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "opensandbox",
    "sandbox",
    "container",
    "cordis",
    "agent"
  ],
  "license": "MIT",
  "author": "codebam",
  "homepage": "https://github.com/codebam/dsh-opensandbox#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codebam/dsh-opensandbox.git"
  },
  "bugs": {
    "url": "https://github.com/codebam/dsh-opensandbox/issues"
  },
  "type": "module",
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./package.json": "./package.json",
    "./workspace-access": "./workspace-access.mjs",
    "./user-access": "./user-access.mjs"
  },
  "files": [
    "index.mjs",
    "cordis.patch.yml",
    "src/",
    "README.md",
    "LICENSE",
    "workspace-access.mjs",
    "user-access.mjs",
    "dev/users/"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check": "for f in index.mjs workspace-access.mjs user-access.mjs src/*.mjs src/users/*.mjs dev/users/*.mjs; do node --check \"$f\" || exit 1; done",
    "test": "node test/mount-policy.mjs && node test/bundle.mjs && node test/mock-e2e.mjs && node test/readiness.mjs && node test/workspace-paths.mjs && node test/workspace-access.mjs",
    "pack:check": "npm pack --dry-run",
    "test:users": "node --test test/users.mjs",
    "test:users-live": "node test/users-live.mjs"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/schemastery": "*",
    "@deepseek-ai/dsh-sandbox": "*",
    "@deepseek-ai/dsh-subprocess": "*",
    "@deepseek-ai/dsh-fs": "*",
    "@deepseek-ai/dsh-fs-local": "*",
    "@deepseek-ai/dsh-workspace": "*",
    "@deepseek-ai/dsh-host-directory-picker": "*",
    "@deepseek-ai/dsh-host-directory-picker-browse": "*",
    "@deepseek-ai/dsh-client-connection": "*",
    "@deepseek-ai/dsh-api-remote-access": "*",
    "@deepseek-ai/dsh-session-query": "*",
    "@deepseek-ai/dsh-agent": "*",
    "@deepseek-ai/dsh-host-webserver": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "@deepseek-ai/dsh-sandbox": {
      "optional": true
    },
    "@deepseek-ai/dsh-subprocess": {
      "optional": true
    },
    "@deepseek-ai/dsh-fs": {
      "optional": true
    },
    "@deepseek-ai/dsh-fs-local": {
      "optional": true
    },
    "@deepseek-ai/dsh-workspace": {
      "optional": true
    },
    "@deepseek-ai/dsh-host-directory-picker": {
      "optional": true
    },
    "@deepseek-ai/dsh-host-directory-picker-browse": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-connection": {
      "optional": true
    },
    "@deepseek-ai/dsh-api-remote-access": {
      "optional": true
    },
    "@deepseek-ai/dsh-session-query": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent": {
      "optional": true
    },
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    }
  }
}
